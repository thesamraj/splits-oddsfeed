FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN pip install --no-cache-dir \
    redis \
    psycopg2-binary \
    requests

# Copy source code
COPY src/ /app/src/
COPY utils/ /app/utils/

# Set Python path
ENV PYTHONPATH=/app:$PYTHONPATH
ENV PYTHONUNBUFFERED=1

# Run the hotfix normalizer
CMD ["python", "/app/src/normalizer/hotfix.py"]
