# Neon Database (required) - NO LOCAL DB, no laptop dependency
# IMPORTANT: Replace placeholders with your actual credentials in .env (never commit real creds)
DATABASE_URL=postgresql://<user>:<pass>@<pooled-host>.neon.tech/<db>?sslmode=require

# Redis broker (cloud-managed or local)
REDIS_URL=redis://broker:6379/0

# Proxy for bypassing blocks (optional)
PROXY_URL=

# Slack webhook for alerts (optional)
SLACK_WEBHOOK=

# Realness validation
REAL_ONLY=true
REALNESS_THRESHOLD=0.9

# Metrics and health ports (standard everywhere)
METRICS_PORT=9090
HEALTH_PORT=9091
REGION=CA
PROXY_MANAGER_URL=http://proxy-manager:8099

# Aggregator (Odds API) real-mode settings
AGG_BASE_URL=https://api.the-odds-api.com/v4
AGG_API_KEY=    # set only in local .env, NEVER commit a real key
AGG_SPORT=americanfootball_nfl
AGG_MARKETS=h2h,spreads,totals
AGG_REGION=us
AGG_USE_MOCK=true
AGG_FETCH_INTERVAL=300          # seconds between requests (cost control)
AGG_DAILY_REQUEST_BUDGET=250    # daily API call limit for cost control
AGG_BUDGET_MIN_REMAINING=10     # hard stop when remaining budget drops below this
AGG_BUDGET_REDIS_KEY=agg:budget  # Redis key prefix for budget tracking (date appended)

# Normalizer data quality settings
NORM_SANITY_PRICE_RANGE=-2000,2000      # American odds range for sanity checks
NORM_SANITY_TOTAL_SPREAD_RANGE=0,200    # Point range for totals and spreads

# BetRivers (Kambi) collector settings
KAMBI_BASE_URL=https://eu-offering.kambicdn.org/offering/v2018
KAMBI_BRAND=betrivers
KAMBI_LOCALE=en_US
KAMBI_SPORT=american_football
KAMBI_LEAGUE=nfl
KAMBI_POLL_INTERVAL=3
KAMBI_USE_MOCK=true

# Collector-kambi image (override for pinning to specific versions)
COLLECTOR_KAMBI_IMAGE=

# Pinnacle Sports collector settings
PIN_BASE_URL=https://api.pinnacle.com
PIN_USERNAME=      # set only in local .env, NEVER commit real credentials
PIN_PASSWORD=      # set only in local .env, NEVER commit real credentials
PIN_SPORT_ID=29    # 29 = American Football/NFL
PIN_LEAGUE_IDS=    # comma-separated league IDs to filter (optional)
PIN_MARKETS=moneyline,spreads,totals
PIN_INTERVAL=5     # seconds between requests in real mode
PIN_USE_MOCK=true  # true for mock data, false for real API
PIN_TIMEOUT_CONNECT=4
PIN_TIMEOUT_READ=6
PIN_ETAG_CACHE=true
PIN_DAILY_REQUEST_BUDGET=10000      # daily API call limit
PIN_BUDGET_MIN_REMAINING=100        # throttle when remaining drops below this
PIN_RATE_LIMIT_SLEEP_MS=250         # milliseconds to sleep between requests
PIN_PROM_PORT=9110                  # Prometheus metrics port

# Collector-pinnacle image (override for pinning to specific versions)
COLLECTOR_PIN_IMAGE=
REPO_OWNER=thesamraj
REPO_NAME=splits-oddsfeed
