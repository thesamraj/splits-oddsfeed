# Database
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Redis
REDIS_URL=rediss://default:password@host:6379

# Proxy settings for Kambi Browser collector
PROXY_HOST=gw.smartproxy.com
PROXY_PORT=7000
PROXY_USER=YOUR_SMARTPROXY_USER
PROXY_PASS=YOUR_SMARTPROXY_PASS

# Other settings
REAL_ONLY=true
REALNESS_THRESHOLD=0.85
LIGHT_SOCCER=true
METRICS_PORT=9090
HEALTH_PORT=9091
PORT=8000