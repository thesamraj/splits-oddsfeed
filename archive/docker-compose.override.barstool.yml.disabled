  barstool-listener:
    image: redis:7-alpine
    container_name: barstool-listener
    restart: unless-stopped
    networks:
      - default
    command: >
      sh -c "
        while true; do
          redis-cli -h broker SUBSCRIBE odds.raw.barstool | head -100
          sleep 30
        done
      "
    depends_on:
      - broker

networks:
  default:
    name: splits-oddsfeed_default
    external: true
