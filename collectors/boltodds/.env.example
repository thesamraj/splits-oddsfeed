# Database
DATABASE_URL=postgresql://user:pass@host/db
REDIS_URL=redis://localhost:6379

# BoltOdds WebSocket API
BOLT_API_TOKEN=your_token_here
BOLT_WS_URL=wss://spro.agency/api?key=your_token_here
BOLT_INFO_URL=https://spro.agency/api/get_info?key=your_token_here
BOLT_REDIS_CHANNEL=odds.raw.bolt

# Other settings
POLL_INTERVAL=30
PORT=8000